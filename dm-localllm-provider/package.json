      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@duckmind/dm-coding-agent": "*"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.7",
    "@duckmind/dm-coding-agent": "file:../../dm-mono/packages/coding-agent"
  }
