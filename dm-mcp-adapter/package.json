{
  "name": "dm-mcp-adapter",
  "version": "2.32.1",
  "description": "MCP (Model Context Protocol) adapter extension for DM.",
  "type": "module",
  "types": "./index.ts",
  "bin": {
    "dm-mcp-adapter": "cli.js"
  },
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts",
      "default": "./index.ts"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./oauth": {
      "types": "./oauth.ts",
      "import": "./oauth.ts",
      "default": "./oauth.ts"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./metadata-cache": {
      "types": "./dist/metadata-cache.d.ts",
      "import": "./dist/metadata-cache.js",
      "default": "./dist/metadata-cache.js"
    }
  },
  "license": "MIT",
  "author": "Nico Bailon",
  "keywords": [
    "duckmind",
    "dm",
    "dm-package",
    "dm-extension",
    "mcp",
    "model-context-protocol"
  ],
  "files": [
    "cli.js",
    "agent-dir.ts",
    "index.ts",
    "error-signal.ts",
    "state.ts",
    "utils.ts",
    "abort.ts",
    "runtime-owner.ts",
    "tool-metadata.ts",
    "ts-shape.ts",
    "search-ranking.ts",
    "tool-approval.ts",
    "init.ts",
    "failure-backoff.ts",
    "ui-session.ts",
    "proxy-modes.ts",
    "direct-tools.ts",
    "namespace-tools.ts",
    "mcp-references.ts",
    "commands.ts",
    "prompts.ts",
    "onboarding-state.ts",
    "mcp-setup-panel.ts",
    "types.ts",
    "ui-stream-types.ts",
    "ui-tool-visibility.ts",
    "ui-app-bridge-helpers.ts",
    "config.ts",
    "package-mcp-loader.ts",
    "server-manager.ts",
    "request-headers-command.ts",
    "unix-socket-transport.ts",
    "json-schema-validator.ts",
    "session-recovery.ts",
    "sampling-handler.ts",
    "elicitation-handler.ts",
    "tool-registrar.ts",
    "tool-result-renderer.ts",
    "mcp-output-guard.ts",
    "mcp-code.ts",
    "mcp-script-worker.mjs",
    "mcp-probe.ts",
    "agent-plugin-loader.ts",
    "resource-tools.ts",
    "lifecycle.ts",
    "mcp-status.ts",
    "metadata-cache.ts",
    "host-html-template.ts",
    "sandbox-proxy-template.ts",
    "ui-resource-handler.ts",
    "consent-manager.ts",
    "ui-server.ts",
    "glimpse-ui.ts",
    "npx-resolver.ts",
    "oauth-handler.ts",
    "oauth.ts",
    "mcp-auth.ts",
    "mcp-bearer-store.ts",
    "mcp-keyring-helper.cjs",
    "mcp-oauth-provider.ts",
    "mcp-callback-server.ts",
    "mcp-auth-flow.ts",
    "mcp-panel.ts",
    "panel-keys.ts",
    "mcp-trace.ts",
    "logger.ts",
    "errors.ts",
    "app-bridge.bundle.js",
    "banner.png",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build:public": "tsc -p tsconfig.public.json",
    "cleanup:package": "node -e \"const fs=require('node:fs'),p=require('node:path');for(const name of fs.readdirSync('dist')){const file=p.join('dist',name);if(name.endsWith('.map'))fs.unlinkSync(file);else if(name.endsWith('.js'))fs.writeFileSync(file,fs.readFileSync(file,'utf8').replace(/\\\\n?\\\\/\\\\/\\\\# sourceMappingURL=[^\\\\n]+\\\\n?$/,'\\\\n'));}\"",
    "prepack": "npm run build:public && npm run cleanup:package",
    "pretest": "npm --prefix examples/interactive-visualizer install --no-audit --no-fund --package-lock=false && npm --prefix examples/interactive-visualizer run build",
    "typecheck": "tsc --noEmit",
    "test": "node test-runner.mjs",
    "test:vitest": "vitest run",
    "test:public-exports": "npm run build:public && node --test public-exports.test.mjs",
    "verify": "npm run typecheck && npm test && npm run test:public-exports"
  },
  "dm": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicobailon/pi-mcp-adapter.git"
  },
  "bugs": {
    "url": "https://github.com/nicobailon/pi-mcp-adapter/issues"
  },
  "homepage": "https://github.com/nicobailon/pi-mcp-adapter#readme",
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/ext-apps": "^1.2.2",
    "@napi-rs/keyring": "^1.3.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cross-spawn": "^7.0.6",
    "open": "^10.2.0",
    "recheck": "^4.5.0",
    "smol-toml": "^1.6.1",
    "strip-json-comments": "^5.0.3",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependencies": {
    "@duckmind/dm-ai": "*",
    "@duckmind/dm-coding-agent": "*",
    "@duckmind/dm-tui": "*",
    "typebox": "*",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@duckmind/dm-ai": {
      "optional": true
    },
    "@duckmind/dm-coding-agent": {
      "optional": true
    },
    "@duckmind/dm-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/conformance": "0.1.16",
    "@types/bun": "^1.0.0",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "20.19.43",
    "@types/open": "^6.2.1",
    "tsx": "^4.21.0",
    "typebox": "1.3.3",
    "typescript": "5.9.3",
    "vitest": "^3.0.0",
    "@duckmind/dm-ai": "file:../../dm-mono/packages/ai",
    "@duckmind/dm-coding-agent": "file:../../dm-mono/packages/coding-agent",
    "@duckmind/dm-tui": "file:../../dm-mono/packages/tui"
  }
}
