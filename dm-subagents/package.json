{
  "name": "dm-subagents",
  "version": "0.83.1",
  "private": true,
  "description": "DM extension for delegating tasks to subagents with chains, parallel execution, and TUI clarification",
  "author": "Nico Bailon",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./agents": "./src/api/agents.ts",
    "./background-work": "./src/api/background-work.ts",
    "./capability-ceiling": "./src/api/capability-ceiling.ts",
    "./child-tool-plan": "./src/api/child-tool-plan.ts",
    "./control-channel": "./src/api/control-channel.ts",
    "./delegation": "./src/api/delegation.ts",
    "./external-job-provider": "./src/api/external-job-provider.ts",
    "./external-runs": "./src/api/external-runs.ts",
    "./inspectors": "./src/api/inspectors.ts",
    "./intercom-bridge": "./src/api/intercom-bridge.ts",
    "./preflight": "./src/api/preflight.ts",
    "./project-panes": "./src/api/project-panes.ts",
    "./required-child-extensions": "./src/api/required-child-extensions.ts",
    "./shared-types": "./src/api/shared-types.ts",
    "./workflow-resources": "./src/api/workflow-resources.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DuckMind/extensions.git"
  },
  "homepage": "https://github.com/DuckMind/extensions/tree/main/dm-subagents#readme",
  "bugs": {
    "url": "https://github.com/DuckMind/extensions/issues"
  },
  "keywords": [
    "duckmind",
    "dm",
    "subagents",
    "ai",
    "agents",
    "cli"
  ],
  "files": [
    "index.ts",
    "src/**/*.ts",
    "*.mjs",
    "agents/",
    "skills/**/*",
    "prompts/**/*",
    "docs/**/*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build:pkg": "node scripts/build-package.mjs",
    "pack:pkg": "npm run build:pkg && npm pack ./dist-pkg",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "node --experimental-strip-types --import ./test/support/isolated-temp-root.mjs --test test/unit/*.test.ts",
    "test:integration": "node --experimental-strip-types --import ./test/support/register-loader.mjs --test test/integration/*.test.ts",
    "test:smoke:tool-activation": "node --experimental-strip-types --test test/smoke/tool-activation.test.ts",
    "test:all": "npm run test:unit && npm run test:integration"
  },
  "dm": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "acorn": "8.18.0",
    "jiti": "2.7.0",
    "undici": "8.11.2",
    "yaml": "2.8.3"
  },
  "peerDependencies": {
    "typebox": "*",
    "@duckmind/dm-coding-agent": ">=0.80.2",
    "@duckmind/dm-agent-core": ">=0.80.2",
    "@duckmind/dm-tui": ">=0.80.2",
    "@duckmind/dm-ai": ">=0.80.2"
  },
  "peerDependenciesMeta": {
    "typebox": {
      "optional": true
    },
    "@duckmind/dm-coding-agent": {
      "optional": true
    },
    "@duckmind/dm-agent-core": {
      "optional": true
    },
    "@duckmind/dm-tui": {
      "optional": true
    },
    "@duckmind/dm-ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@oxlint/plugins": "1.80.0",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "oxlint": "1.80.0",
    "typescript": "5.9.3",
    "typebox": "1.3.27",
    "@duckmind/dm-coding-agent": "file:../../dm-mono/packages/coding-agent",
    "@duckmind/dm-agent-core": "file:../../dm-mono/packages/agent",
    "@duckmind/dm-tui": "file:../../dm-mono/packages/tui",
    "@duckmind/dm-ai": "file:../../dm-mono/packages/ai"
  }
}
