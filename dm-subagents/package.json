{
  "name": "dm-subagents",
  "version": "0.60.0",
  "description": "DM extension for delegating tasks to subagents with chains, parallel execution, and TUI clarification",
  "author": "Nico Bailon",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "duckmind",
    "dm",
    "subagents",
    "ai",
    "agents",
    "cli"
  ],
  "files": [
    "index.ts",
    "src/**/*.ts",
    "*.mjs",
    "agents/",
    "skills/**/*",
    "prompts/**/*",
    "docs/**/*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "node --experimental-strip-types --import ./test/support/isolated-temp-root.mjs --test test/unit/*.test.ts",
    "test:integration": "node --experimental-strip-types --import ./test/support/register-loader.mjs --test test/integration/*.test.ts",
    "test:e2e": "node --experimental-strip-types --import ./test/support/register-loader.mjs --test test/e2e/*.test.ts",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e"
  },
  "dm": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "acorn": "8.18.0",
    "jiti": "2.7.0",
    "typebox": "1.1.38",
    "yaml": "2.8.3"
  },
  "peerDependencies": {
    "@duckmind/dm-coding-agent": "*",
    "@duckmind/dm-agent-core": "*",
    "@duckmind/dm-tui": "*",
    "@duckmind/dm-ai": ">=0.80.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.80.0",
    "@types/node": "24.13.3",
    "oxlint": "1.80.0",
    "typescript": "5.9.3",
    "@duckmind/dm-coding-agent": "file:../../dm-mono/packages/coding-agent",
    "@duckmind/dm-agent-core": "file:../../dm-mono/packages/agent",
    "@duckmind/dm-tui": "file:../../dm-mono/packages/tui",
    "@duckmind/dm-ai": "file:../../dm-mono/packages/ai"
  }
}
